  "feature_definitions": [
    {
      "name": "tenure_years",
      "polars_expr": "(pl.lit('2024-12-31').str.to_date() - pl.col('Joining_Date')).dt.total_days() / 365.25",
      "sql_expr": "DATEDIFF('day', Joining_Date, DATE '2024-12-31') / 365.25",
      "rationale": "Calculates employee tenure in years relative to an anchor end date to understand workforce maturity.",
      "expected_insight": "Longer-tenured employees may exhibit diminishing performance growth if salary increases fail to track market rates."
    },
    {
      "name": "dept_salary_ratio",
      "polars_expr": "pl.col('Salary') / pl.col('Salary').mean().over('Department')",
      "sql_expr": "Salary / AVG(Salary) OVER (PARTITION BY Department)",
      "rationale": "Measures individual compensation relative to the departmental average to identify internal equity and wage distribution.",
      "expected_insight": "Departments with high variance (ratios > 1.5) reflect heavy reliance on highly compensated senior individual contributors."
    },
    {
      "name": "comp_performance_efficiency",
      "polars_expr": "pl.col('Performance_Score') / (pl.col('Salary') / 100000.0)",
      "sql_expr": "Performance_Score / NULLIF(Salary / 100000.0, 0)",
      "rationale": "Calculates performance output generated per 100,000 currency units of salary spent.",
      "expected_insight": "Junior staff and mid-tier roles demonstrate higher performance-to-cost efficiency compared to executive tiers."
    },
    {
      "name": "regional_salary_ratio",
      "polars_expr": "pl.col('Salary') / pl.col('Salary').mean().over('Region')",
      "sql_expr": "Salary / AVG(Salary) OVER (PARTITION BY Region)",
      "rationale": "Compares compensation against the regional average to detect regional pay disparities and cost-of-living premiums.",
      "expected_insight": "Metropolitan technology regions (e.g., South/West) will present higher median salary baselines than other operational hubs."
    },
    {
      "name": "performance_dept_zscore",
      "polars_expr": "(pl.col('Performance_Score') - pl.col('Performance_Score').mean().over('Department')) / pl.col('Performance_Score').std().over('Department')",
      "sql_expr": "(Performance_Score - AVG(Performance_Score) OVER (PARTITION BY Department)) / NULLIF(STDDEV_SAMP(Performance_Score) OVER (PARTITION BY Department), 0)",
      "rationale": "Normalizes performance scores within each department to enable fair cross-departmental top-talent identification.",
      "expected_insight": "Highlights top performers (+2 Z-score) in departments with conservative grading scales that otherwise look average on raw score benchmarks."
    }
  ],
