  "generated_queries": [
    {
      "id": "executive_kpi_summary",
      "title": "Executive HR KPI Summary",
      "business_question": "What is the average compensation-to-performance efficiency and average salary across all employees?",
      "sql": "SELECT COUNT(\"Employee_Name\") AS total_employees, ROUND(AVG(\"Salary\"), 2) AS avg_salary, ROUND(AVG(\"Performance_Score\"), 2) AS avg_performance_score, ROUND(AVG(\"comp_performance_efficiency\"), 2) AS avg_comp_efficiency FROM data",
      "x_axis": null,
      "y_axis": null,
      "group_by": null,
      "chart_type": "kpi_card",
      "insight_summary": "Provides the headline KPI for average compensation-performance efficiency, indicating how well salaries align with performance scores.",
      "priority": 1,
      "analytical_purpose": "kpi"
    },
    {
      "id": "headcount_hiring_trend_monthly",
      "title": "Monthly Hiring Volume Trend",
      "business_question": "How has employee hiring volume evolved month-over-month?",
      "sql": "SELECT DATE_TRUNC('month', \"Joining_Date\") AS join_month, COUNT(\"Employee_Name\") AS hires_count, ROUND(AVG(\"Salary\"), 2) AS avg_hire_salary FROM data GROUP BY 1 ORDER BY 1",
      "x_axis": "join_month",
      "y_axis": "hires_count",
      "group_by": null,
      "chart_type": "line",
      "insight_summary": "Tracks historical onboarding velocity and salary levels offered to new joiners over time.",
      "priority": 2,
      "analytical_purpose": "trend"
    },
    {
      "id": "quarterly_compensation_performance_trend",
      "title": "Quarterly Salary & Performance Trends by Hiring Cohort",
      "business_question": "How do average salary and performance scores compare across hiring quarters?",
      "sql": "SELECT DATE_TRUNC('quarter', \"Joining_Date\") AS join_quarter, ROUND(AVG(\"Salary\"), 2) AS avg_salary, ROUND(AVG(\"Performance_Score\"), 2) AS avg_performance FROM data GROUP BY 1 ORDER BY 1",
      "x_axis": "join_quarter",
      "y_axis": "avg_salary",
      "group_by": null,
      "chart_type": "line",
      "insight_summary": "Highlights whether earlier or recent hiring cohorts demonstrate higher average salaries and performance ratings.",
      "priority": 2,
      "analytical_purpose": "trend"
    },
    {
      "id": "departmental_compensation_breakdown",
      "title": "Departmental Salary & Headcount Breakdown",
      "business_question": "How are headcount, average salary, and overall performance distributed across departments?",
      "sql": "SELECT \"Department\", COUNT(\"Employee_Name\") AS employee_count, ROUND(AVG(\"Salary\"), 2) AS avg_salary, ROUND(AVG(\"Performance_Score\"), 2) AS avg_performance_score FROM data GROUP BY \"Department\" ORDER BY avg_salary DESC",
      "x_axis": "Department",
      "y_axis": "avg_salary",
      "group_by": null,
      "chart_type": "bar",
      "insight_summary": "Slices workforce compensation and talent concentration by functional department to identify resource allocation.",
      "priority": 3,
      "analytical_purpose": "breakdown"
    },
    {
      "id": "regional_performance_breakdown",
      "title": "Regional & City Workforce Distribution",
      "business_question": "What is the headcount, average salary, and efficiency metrics for each department?",
      "sql": "SELECT \"Department\", COUNT(\"Employee_Name\") AS employee_count, ROUND(AVG(\"Salary\"), 2) AS avg_salary, ROUND(AVG(\"Performance_Score\"), 2) AS avg_score FROM data GROUP BY \"Department\" ORDER BY employee_count DESC",
      "x_axis": "Department",
      "y_axis": "avg_salary",
      "group_by": "Region",
      "chart_type": "bar",
      "insight_summary": "Shows the distribution of employees and their average compensation levels across different departments.",
      "priority": 3,
      "analytical_purpose": "breakdown"
    },
    {
      "id": "dept_salary_vs_company_benchmark",
      "title": "Department Average Salary vs Company Benchmark",
      "business_question": "How far does each department's average salary deviate from the overall company average?",
      "sql": "SELECT \"Department\", ROUND(AVG(\"Salary\"), 2) AS dept_avg_salary, ROUND((AVG(\"Salary\") - (SELECT AVG(\"Salary\") FROM data)) / NULLIF((SELECT AVG(\"Salary\") FROM data), 0) * 100, 2) AS pct_diff_from_company_avg FROM data GROUP BY \"Department\" ORDER BY pct_diff_from_company_avg DESC",
      "x_axis": "Department",
      "y_axis": "pct_diff_from_company_avg",
      "group_by": null,
      "chart_type": "bar",
      "insight_summary": "Benchmarks each department's mean compensation directly against the organizational average percentage baseline.",
      "priority": 5,
      "analytical_purpose": "comparison"
    }
  ],
