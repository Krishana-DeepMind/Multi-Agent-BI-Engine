  "generated_queries": [
    {
      "id": "compensation_overview_kpis",
      "title": "Company Compensation & Performance Snapshot",
      "business_question": "What is the immediate executive summary of company-wide headcount, average salary, and average performance?",
      "sql": "SELECT COUNT(*) AS employee_count, ROUND(AVG(Salary), 2) AS avg_salary, MIN(Salary) AS min_salary, MAX(Salary) AS max_salary, ROUND(AVG(Performance_Score), 2) AS avg_perf, MEDIAN(Salary) AS median_salary FROM data",
      "x_axis": null,
      "y_axis": null,
      "group_by": null,
      "chart_type": "kpi_card",
      "insight_summary": "Captures primary financial and productivity metrics including average and median salary to identify potential wage inflation and overall headcount size for strategic budgeting.",
      "priority": 1,
      "analytical_purpose": "kpi"
    },
    {
      "id": "comp_cost_vs_analysis",
      "title": "Salary Effectiveness Analysis",
      "business_question": "What is the correlation between salary expenditure and employee performance scores?",
      "sql": "SELECT Salary AS avg_salary, ROUND(AVG(Performance_Score), 2) AS avg_performance_score, COUNT(*) AS emp_count FROM data GROUP BY Salary ORDER BY Salary",
      "x_axis": "avg_salary",
      "y_axis": "avg_performance_score",
      "group_by": null,
      "chart_type": "scatter",
      "insight_summary": "Visualizes the association between pay levels and performance to identify if higher compensation correlates directly with higher productivity or if diminishing returns occur at top salary bands.",
      "priority": 5,
      "analytical_purpose": "relationship"
    },
    {
      "id": "regional_performance_compare",
      "title": "Regional Workforce Performance Index",
      "business_question": "Which geographical regions demonstrate the highest average performance and headcount stability?",
      "sql": "SELECT Region, COUNT(DISTINCT Employee_Name) AS total_headcount, ROUND(AVG(Performance_Score), 2) AS avg_performance, ROUND(STDDEV_SAMP(Performance_Score), 2) AS perf_volatility FROM data GROUP BY Region ORDER BY avg_performance DESC",
      "x_axis": "Region",
      "y_axis": "avg_performance",
      "group_by": null,
      "chart_type": "bar",
      "insight_summary": "Evaluates regional productivity to aid in location-specific hiring decisions and resource allocation across different geographical business hubs.",
      "priority": 3,
      "analytical_purpose": "breakdown"
    },
    {
      "id": "dept_comp_struct",
      "title": "Departmental Compensation Cost Analysis",
      "business_question": "How is total salary expenditure distributed across departments, and which is the largest financial sink?",
      "sql": "SELECT Department, ROUND(SUM(Salary), 2) AS total_comp_cost, ROUND(COUNT(DISTINCT Employee_Name), 2) AS headcount FROM data GROUP BY Department ORDER BY total_comp_cost DESC",
      "x_axis": "Department",
      "y_axis": "total_comp_cost",
      "group_by": null,
      "chart_type": "bar",
      "insight_summary": "Provides a composition view of the payroll budget, highlighting which functional areas require the most significant financial investment relative to the rest of the organization.",
      "priority": 4,
      "analytical_purpose": "composition"
    },
    {
      "id": "salary_efficiency_anomaly",
      "title": "Salary per Performance Point Outliers",
      "business_question": "Which departments or individuals show the least effective salary-to-performance ratio (highest cost per point)?",
      "sql": "SELECT Department, Employee_Name, Salary, Performance_Score, salary_per_performance_point FROM data ORDER BY salary_per_performance_point DESC LIMIT 15",
      "x_axis": "Employee_Name",
      "y_axis": "salary_per_performance_point",
      "group_by": null,
      "chart_type": "data_table",
      "insight_summary": "Identifies specific areas of financial inefficiency where high salaries are not matched by high performance scores, providing a list for performance management or compensation review.",
      "priority": 5,
      "analytical_purpose": "anomaly"
    },
    {
      "id": "dept_performance_variance",
      "title": "Performance Consistency by Department",
      "business_question": "Which departments exhibit the highest variance in employee performance results?",
      "sql": "SELECT Department, ROUND(AVG(dept_performance_variance), 2) AS avg_variance, ROUND(AVG(Performance_Score), 2) AS avg_score FROM data GROUP BY Department",
      "x_axis": "Department",
      "y_axis": "avg_variance",
      "group_by": null,
      "chart_type": "bar",
      "insight_summary": "High variance indicates inconsistent team performance which may signal management issues or diverse role definitions, making it a key indicator for HR risk mitigation.",
      "priority": 3,
      "analytical_purpose": "distribution"
    },
    {
      "id": "salary_percentile_heatmap",
      "title": "Compensation Distribution Matrix",
      "business_question": "How do departmental structures align with regional performance indices?",
      "sql": "SELECT Department, ROUND(AVG(region_performance_index), 2) AS avg_region_perf, ROUND(AVG(salary_percentile_vs_dept), 2) AS avg_percentile FROM data GROUP BY Department ORDER BY Department",
      "x_axis": "Department",
      "y_axis": "avg_region_perf",
      "group_by": null,
      "chart_type": "data_table",
      "insight_summary": "Offers a dual-metric view of how performance in a region compares to the internal salary positioning of a department, allowing for complex cross-functional benchmarking.",
      "priority": 5,
      "analytical_purpose": "comparison"
    }
  ],
